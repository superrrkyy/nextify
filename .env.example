# Database - Use PostgreSQL in production, SQLite for local dev
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/nextify?schema=public"

# JWT
JWT_SECRET="super-secret-jwt-key-change-in-production-32chars"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-32chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Storage (S3 compatible or local)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="nextify-audio"
STORAGE_REGION="us-east-1"

# Client
VITE_API_URL="http://localhost:4000/api"
VITE_APP_NAME="Nextify"
